PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"

JWT_ACCESS_SECRET="your-jwt-access-secret-key"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN=7d

SEED_ADMIN_EMAIL=admin@booking.com
SEED_ADMIN_PASSWORD="change-me-admin-password"
